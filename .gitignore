```gitignore
# Compiled and binary files
*.pyc
__pycache__/
*.o
*.obj
*.so
*.dll
*.exe

# Dependencies
venv/
.venv/
.env
.env.local
*.env.*

# Build artifacts
build/
dist/
*.egg-info/

# Editors
.vscode/
.idea/
*.swp
*.swo

# Logs and temp files
*.log
*.tmp

# Coverage
.coverage
coverage/
htmlcov/

# Python cache
.mypy_cache/
.pytest_cache/
```