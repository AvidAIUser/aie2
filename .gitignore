```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj

# Dependencies
.venv/
venv/

# Logs and temp files
*.log
*.tmp
*.swp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Coverage reports
.coverage
coverage/
htmlcov/

# Python specific
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.egg/

# Distribution / packaging
.dist-info/
.installed.cfg
*.egg

# Pytest
.pytest_cache/
```